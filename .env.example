# Public Supabase connection values. The publishable key is designed for browser use;
# authorization is enforced by Row Level Security. Set NEXT_PUBLIC_APP_URL to
# https://mpk-academy.vercel.app in the Vercel production environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Closed beta. Beta mode is ON unless this is exactly "false": pricing and
# checkout are hidden and access comes from invite codes. Keep it on for any
# deployment on Vercel Hobby (non-commercial use only).
NEXT_PUBLIC_BETA_MODE=true
# Shown to visitors for invite requests and privacy requests, for example a
# Namecheap forwarding address such as support@mpkacademy.com. Auth emails are
# sent separately by Supabase from no-reply@mpkacademy.com.
NEXT_PUBLIC_CONTACT_EMAIL=
# Comma-separated emails allowed to open /admin. Server-only.
ADMIN_EMAILS=

# AI writing and speaking feedback (server-only; see docs/AI_OPERATIONS.md). Without
# GROQ_API_KEY the feature stays hidden. JOBS_SECRET protects /api/jobs/run,
# which pg_cron calls; use at least 32 random characters.
GROQ_API_KEY=
JOBS_SECRET=
# Optional model overrides: writing feedback (openai/gpt-oss-120b), speaking
# feedback (qwen/qwen3.8-27b, a Groq preview model), and transcription
# (whisper-large-v3-turbo).
GROQ_WRITING_MODEL=
GROQ_SPEAKING_MODEL=
GROQ_SPEECH_MODEL=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# The service role key is used for Stripe fulfillment, durable error logging,
# anonymous funnel counts, and the /admin beta tools.
SUPABASE_SERVICE_ROLE_KEY=
# Use Stripe test-mode keys while beta mode is on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_COMPLETE=
# Retired plan; kept so historical purchases still reconcile.
STRIPE_PRICE_INTENSIVE=

# Content tools only (scripts/content; see docs/CONTENT_PIPELINE.md). Keep these
# in .env.local on the machine that makes content; never add them to Vercel.
# Azure AI Speech, free F0 tier: listening audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Gemini free tier: drafts of new questions. It never sees learner data.
GEMINI_API_KEY=
GEMINI_MODEL=
